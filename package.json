{
  "name": "chenstricks-motion",
  "version": "0.1.0",
  "private": true,
  "description": "chenstricks Motion — 让已完成的图片局部动起来 / 把一段信息变成信息动画，输出可直接导入剪映的短视频 MP4",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "bundle": "remotion bundle src/index.ts out/bundle",
