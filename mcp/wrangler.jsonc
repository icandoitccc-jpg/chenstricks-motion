{
  "name": "motion-guides",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HANDOFFS",
        "class_name": "HandoffSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "handoff-v1",
      "new_sqlite_classes": [
        "HandoffSession"
      ]
    }
  ]
}
