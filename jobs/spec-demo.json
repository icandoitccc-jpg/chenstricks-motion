      { "action": "highlight", "target": "cc2", "beat": "b4", "offset": 26, "color": "#E8A33D" },
      { "action": "cameraPush", "target": "camera", "beat": "b4", "offset": 34, "region": { "x": 430, "y": 840, "w": 1060, "h": 180 }, "speed": "normal" },
      { "action": "cameraPull", "target": "camera", "beat": "b4", "offset": 78, "speed": "normal" },
