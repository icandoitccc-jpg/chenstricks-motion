      { "action": "popIn", "target": "chipL", "beat": "b1", "offset": 28 },
      { "action": "popIn", "target": "chipLt", "beat": "b1", "offset": 28 },
      { "action": "popIn", "target": "chipR", "beat": "b1", "offset": 34 },
      { "action": "popIn", "target": "chipRt", "beat": "b1", "offset": 34 },

